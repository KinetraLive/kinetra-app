{
  "name": "kinetra",
  "version": "0.1.0",
  "description": "Kinetra: broadcast graphics for OBS and vMix",
  "author": "Rørvik Medieteknikk",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p renderer --noEmit",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:renderer": "pnpm --dir renderer build",
    "test:e2e": "pnpm --dir renderer build && playwright test",
    "perf:renderer": "pnpm --dir renderer build && playwright test --config playwright.perf.config.ts",
    "shots:presets": "pnpm --dir renderer build && playwright test --config playwright.thumbs.config.ts",
    "shots:ui": "pnpm --dir renderer build && playwright test --config playwright.ui.config.ts",
    "perf:ui": "pnpm --dir renderer build && playwright test --config playwright.ui-perf.config.ts",
    "licenses": "node scripts/licenses.mjs",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "icon:canary": "node scripts/canary-icon.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/common": "^1.5.3",
    "@lezer/css": "^1.3.8",
    "@lezer/highlight": "^1.2.5",
    "@lezer/html": "^1.3.13",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2",
    "@xyflow/svelte": "1.7.0",
    "lucide-svelte": "^1.0.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.4",
    "jsdom": "^30.1.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
