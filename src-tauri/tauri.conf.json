{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kinetra",
  "version": "0.1.0",
  "identifier": "no.rorvikmedieteknikk.kinetra",
  "build": {
    "beforeDevCommand": "pnpm --dir renderer build && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir renderer build && pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kinetra",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3MEU4NEEyMUE3NUFGQzgKUldUSXIzVWFvb1FPWnlxbENsdERJcmZ1L3VaTEU4SUdUVkNsRlJsS0VRUUsvMElUTnd2L2tBVW8K"
    }
  }
}
