{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the app windows (main, Preferences)",
  "windows": [
    "main",
    "prefs"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "dialog:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir"
  ]
}
