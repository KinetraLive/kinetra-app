{
  "schemaVersion": 1,
  "name": "Slide-in accent",
  "description": "An accent block slides in, then the name panel.",
  "preset": { "id": "slide-in-accent", "version": 3 },
  "fields": [
    { "key": "name", "label": "Name", "type": "text", "default": "" },
    { "key": "title", "label": "Title", "type": "text", "default": "" },
    { "key": "tag", "label": "Tag", "type": "text", "default": "" }
  ],
  "variables": [
    { "key": "accent", "label": "Accent", "type": "color", "default": "#e6332a" },
    { "key": "ink", "label": "Tag text", "type": "color", "default": "#ffffff" },
    { "key": "panel", "label": "Panel", "type": "color", "default": "#ffffff" },
    { "key": "text", "label": "Text", "type": "color", "default": "#111418" },
    { "key": "font", "label": "Font", "type": "font", "default": "Montserrat" },
    { "key": "scale", "label": "Size", "type": "range", "min": 0.5, "max": 1.5, "step": 0.05, "unit": "", "default": "1" },
    { "key": "radius", "label": "Corner radius", "type": "range", "min": 0, "max": 24, "step": 1, "unit": "px", "default": "0" },
    {
      "key": "align",
      "label": "Position",
      "type": "select",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    }
  ],
  "autoOutMs": null,
  "design": { "w": 656, "h": 133, "x": 154, "y": 861, "sizing": "fit" },
  "updatedAt": ""
}
