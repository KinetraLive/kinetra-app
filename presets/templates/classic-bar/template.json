  "variables": [
    { "key": "accent", "label": "Accent", "type": "color", "default": "#ffb81c" },
    { "key": "panel", "label": "Bar", "type": "color", "default": "#0d1b2ae6" },
    { "key": "text", "label": "Text", "type": "color", "default": "#ffffff" },
    { "key": "font", "label": "Font", "type": "font", "default": "Barlow" },
    { "key": "scale", "label": "Size", "type": "range", "min": 0.5, "max": 1.5, "step": 0.05, "unit": "", "default": "1" },
    { "key": "radius", "label": "Corner radius", "type": "range", "min": 0, "max": 24, "step": 1, "unit": "px", "default": "2" },
