{
  "schemaVersion": 1,
  "name": "Classic bar",
  "description": "Name and title on a solid bar with an accent stripe.",
  "preset": { "id": "classic-bar", "version": 3 },
  "fields": [
    { "key": "name", "label": "Name", "type": "text", "default": "" },
    { "key": "title", "label": "Title", "type": "text", "default": "" }
