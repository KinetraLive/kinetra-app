{
  "schemaVersion": 2,
  "name": "Scoreboard",
  "description": "A score bug with both teams, period and game clock.",
  "preset": { "id": "scoreboard", "version": 3 },
  "fields": [
    { "key": "home", "label": "Home team", "type": "text", "default": "" },
    { "key": "home_score", "label": "Home score", "type": "number", "default": "" },
    { "key": "away", "label": "Away team", "type": "text", "default": "" },
    { "key": "away_score", "label": "Away score", "type": "number", "default": "" },
    { "key": "period", "label": "Period", "type": "text", "default": "" },
    { "key": "clock", "label": "Game clock", "type": "timer", "default": "{\"run\":false,\"at\":0,\"base\":1200000,\"dir\":\"down\",\"end\":\"stop\"}" }
  ],
  "variables": [
    {
      "key": "position",
      "label": "Position",
      "type": "select",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" }
      ],
      "default": "top-left"
    },
    { "key": "home_color", "label": "Home color", "type": "color", "default": "#e63946" },
    { "key": "away_color", "label": "Away color", "type": "color", "default": "#3a86ff" },
    { "key": "accent", "label": "Clock accent", "type": "color", "default": "#f2c14e" },
    { "key": "panel", "label": "Background", "type": "color", "default": "#0b0e13eb" },
    { "key": "text", "label": "Text", "type": "color", "default": "#ffffff" },
    { "key": "font", "label": "Font", "type": "font", "default": "Barlow Condensed" },
    { "key": "scale", "label": "Size", "type": "range", "min": 0.5, "max": 1.5, "step": 0.05, "unit": "", "default": "1" },
    { "key": "radius", "label": "Corner radius", "type": "range", "min": 0, "max": 16, "step": 1, "unit": "px", "default": "4" },
    { "key": "secondary", "label": "Secondary", "type": "color", "default": "#b3bac5" },
    { "key": "plate", "label": "Plate", "type": "color", "default": "#0c0d11d9" },
    { "key": "font-heading", "label": "Heading font", "type": "font", "default": "Space Grotesk" },
    { "key": "font-body", "label": "Body font", "type": "font", "default": "IBM Plex Sans" },
    { "key": "speed", "label": "Animation speed", "type": "range", "min": 0.5, "max": 2, "step": 0.1, "unit": "", "default": "1" }
  ],
  "autoOutMs": null,
  "design": { "w": 700, "h": 68, "x": 96, "y": 65, "sizing": "fit" },
