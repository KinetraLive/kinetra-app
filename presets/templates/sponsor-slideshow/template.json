{
  "schemaVersion": 2,
  "name": "Sponsor slideshow",
  "description": "A sponsor logo at a time, with its name, a transition of your choice and a progress bar.",
  "preset": { "id": "sponsor-slideshow", "version": 2 },
  "fields": [
    { "key": "label", "label": "Label", "type": "text", "default": "" },
    {
      "key": "slides",
      "label": "Slides",
      "type": "list",
      "columns": [
        { "key": "logo", "label": "Logo", "kind": "image" },
        { "key": "name", "label": "Name" },
        { "key": "tagline", "label": "Tagline" },
        { "key": "tier", "label": "Tier" },
        { "key": "duration", "label": "Duration" }
      ],
      "default": "[]"
    }
  ],
  "variables": [
    {
      "key": "position",
      "label": "Position",
      "type": "select",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-right", "label": "Top right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "bottom-right"
    },
    {
      "key": "motion",
      "label": "Transition",
      "type": "select",
      "options": [
        { "value": "fade", "label": "Fade" },
        { "value": "crossfade", "label": "Crossfade" },
        { "value": "slide", "label": "Slide" },
        { "value": "zoom", "label": "Zoom" }
      ],
      "default": "crossfade"
    },
    { "key": "motion-ms", "label": "Transition duration", "type": "range", "min": 100, "max": 2000, "step": 50, "unit": "ms", "default": "700" },
    {
      "key": "progress",
      "label": "Progress bar",
      "type": "select",
      "options": [
        { "value": "block", "label": "Show" },
        { "value": "none", "label": "Hide" }
      ],
      "default": "block"
    },
    { "key": "interval", "label": "Seconds per slide", "type": "range", "min": 1, "max": 120, "step": 1, "unit": "s", "default": "6" },
    { "key": "accent", "label": "Accent", "type": "color", "default": "#e63946" },
    { "key": "secondary", "label": "Secondary", "type": "color", "default": "#aab1bd" },
    { "key": "text", "label": "Text", "type": "color", "default": "#f5f5f2" },
    { "key": "plate", "label": "Card", "type": "color", "default": "#14171ef2" },
    {
      "key": "logo-bg",
      "label": "Logo background",
      "type": "select",
      "options": [
        { "value": "off", "label": "Off" },
        { "value": "on", "label": "On" }
      ],
      "default": "off"
    },
    { "key": "font-heading", "label": "Heading font", "type": "font", "default": "Montserrat" },
    { "key": "font-body", "label": "Body font", "type": "font", "default": "Montserrat" },
    { "key": "radius", "label": "Corner radius", "type": "range", "min": 0, "max": 24, "step": 1, "unit": "px", "default": "10" },
    { "key": "speed", "label": "Animation speed", "type": "range", "min": 0.5, "max": 2, "step": 0.1, "unit": "", "default": "1" }
  ],
  "autoOutMs": null,
  "design": { "w": 520, "h": 400, "x": 1285, "y": 594, "sizing": "fit" },
  "defaultVariant": "classic",
  "variants": [
