{
  "schemaVersion": 1,
  "name": "Leaderboard",
  "description": "Ranked standings with the top three highlighted.",
  "preset": { "id": "leaderboard", "version": 3 },
  "fields": [
    { "key": "title", "label": "Title", "type": "text", "default": "" },
