{
  "schemaVersion": 1,
  "name": "Next up countdown",
  "description": "What's up next, with a big countdown to its start.",
  "preset": { "id": "next-up", "version": 3 },
  "fields": [
    { "key": "label", "label": "Label", "type": "text", "default": "" },
    { "key": "status", "label": "Status", "type": "text", "default": "" },
    { "key": "title", "label": "Title", "type": "text", "default": "" },
    { "key": "subtitle", "label": "Subtitle", "type": "text", "default": "" },
    { "key": "location", "label": "Location", "type": "text", "default": "" },
    {
      "key": "countdown",
      "label": "Countdown",
      "type": "timer",
      "default": "{\"run\":false,\"at\":0,\"base\":300000,\"dir\":\"down\",\"end\":\"stop\"}"
    }
  ],
  "variables": [
    {
      "key": "layout",
      "label": "Layout",
      "type": "select",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "corner", "label": "Corner card" }
      ],
      "default": "full"
    },
    { "key": "accent", "label": "Accent", "type": "color", "default": "#4cc9f0" },
    { "key": "warning", "label": "Delayed", "type": "color", "default": "#ffb020" },
    { "key": "ink", "label": "Text on label", "type": "color", "default": "#0b0e13" },
    { "key": "panel", "label": "Background", "type": "color", "default": "#0b0e13f2" },
    { "key": "text", "label": "Text", "type": "color", "default": "#ffffff" },
    { "key": "font", "label": "Font", "type": "font", "default": "Oswald" },
    { "key": "scale", "label": "Size", "type": "range", "min": 0.5, "max": 1.5, "step": 0.05, "unit": "", "default": "1" },
    { "key": "radius", "label": "Corner radius", "type": "range", "min": 0, "max": 24, "step": 1, "unit": "px", "default": "10" }
  ],
  "autoOutMs": null,
  "design": { "w": 1920, "h": 1080, "x": 0, "y": 0, "sizing": "reflow" },
  "updatedAt": ""
}
